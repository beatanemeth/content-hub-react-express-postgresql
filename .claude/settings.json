{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": ""
  },
  "permissions": {
    "allow": [
      "Bash(node --version)",
      "Bash(npm --version)",
      "Bash(npm ls*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch --show-current)",
      "Bash(npx tsc --noEmit*)",
      "Bash(npx eslint*)",
      "Bash(npx prettier --check*)"
    ],
    "ask": [
      "Bash(npm install*)",
      "Bash(npm i *)",
      "Bash(npm uninstall*)",
      "Bash(npm update*)",
      "Bash(npm ci*)",
      "Bash(npm audit fix*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git branch*)",
      "Bash(git restore*)",
      "Bash(git switch*)",
      "Bash(git init*)"
    ],
    "deny": [
      "Bash(npm publish*)",
      "Bash(npm install -g*)",
      "Bash(npm i -g*)",
      "Bash(git push*)",
      "Bash(git pull*)",
      "Bash(git fetch*)",
      "Bash(git clone*)",
      "Bash(git reset --hard*)",
      "Bash(git rebase*)",
      "Bash(git merge*)",
      "Bash(git checkout*)",
      "Bash(git revert*)",
      "Bash(git tag*)",
      "Bash(git clean*)",
      "Bash(git stash drop*)",
      "Bash(docker*)",
      "Read(**/.env)"
    ]
  }
}
